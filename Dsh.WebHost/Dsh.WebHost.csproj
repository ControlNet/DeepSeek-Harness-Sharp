<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\src\Dsh.Plugins.Generator\DshPluginHost.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dsharp-web</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Dsh.Host\Dsh.Host.csproj" />
    <ProjectReference Include="..\src\Dsh.WebBridge\Dsh.WebBridge.csproj" />
  </ItemGroup>
  <Import Project="..\Dsh.Host\Dsh.Host.Publish.targets" />
</Project>
