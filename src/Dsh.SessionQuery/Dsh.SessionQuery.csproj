<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Dsh.Plugins.Generator\DshPluginPackage.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dsh.Runtime\Dsh.Runtime.csproj" />
    <ProjectReference Include="..\Dsh.Core\Dsh.Core.csproj" />
    <ProjectReference Include="..\Dsh.Llm\Dsh.Llm.csproj" />
    <ProjectReference Include="..\Dsh.Interaction\Dsh.Interaction.csproj" />
    <ProjectReference Include="..\Dsh.Plugins.Abstractions\Dsh.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <!-- FtsSessionTextSearch 唯一初始化 provider; SourceGear 随 RID 发布同名原生库(含 FTS5), 不依赖系统 sqlite3 或反射初始化 bundle。 -->
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
  </ItemGroup>

</Project>
