<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dsh.Gui.ViewModels"
        xmlns:term="using:Dsh.Gui.Terminal"
        x:Class="Dsh.Gui.Views.TerminalWindow"
        x:DataType="vm:TerminalViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource Brush.Bg.Card}">

  <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="8">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="{Binding Title}" Classes="Secondary" VerticalAlignment="Center" />
      <TextBlock Text="{Binding ScreenTitle}" Classes="Secondary" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Status}" Classes="Tertiary" VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="1" ClipToBounds="True" CornerRadius="{DynamicResource CornerRadius.Card}">
      <term:TerminalControl Name="Terminal" Session="{Binding Session}" />
    </Border>
  </Grid>
</Window>
