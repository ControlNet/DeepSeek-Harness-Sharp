<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dsh.Gui.ViewModels"
             x:Class="Dsh.Gui.Views.SessionTranscriptView"
             x:DataType="vm:SessionTranscriptViewModel"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Classes="Pill error" HorizontalAlignment="Center" Margin="0,6" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding Error}" Classes="Tertiary" TextWrapping="Wrap" />
    </Border>

    <ListBox Grid.Row="1" Name="MessageList" Classes="MessageList" ItemsSource="{Binding Messages}"
             ItemTemplate="{StaticResource Template.TranscriptMessage}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <Border Grid.Row="2" Margin="20,10,20,10" Padding="12,10"
            Background="{DynamicResource Brush.Bg.Card}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadius.Card}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Name="InputBox" Classes="Bare" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="40" MaxHeight="180" PlaceholderText="{Binding Placeholder}"
                 Text="{Binding Input}" />
        <Button Grid.Column="1" Classes="Send" Command="{Binding SendCommand}" ToolTip.Tip="发送 (Enter)" VerticalAlignment="Bottom">
          <Path Classes="Icon" Width="16" Height="16" Stroke="{DynamicResource Brush.Text.OnAccent}" Data="{StaticResource Icon.Send}" />
        </Button>
        <Button Grid.Column="2" Classes="Chip" Command="{Binding CancelCommand}" ToolTip.Tip="中断当前回合" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Classes="Icon" Width="12" Height="12" Data="{StaticResource Icon.Stop}" />
            <TextBlock Text="中断" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
