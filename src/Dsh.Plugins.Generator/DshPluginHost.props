<Project>

  <!-- 宿主程序接入点:引入生成器,产出聚合目录 DshPluginCatalog,并以模块初始化自注册。 -->
  <PropertyGroup>
    <DshPluginHost>true</DshPluginHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Dsh.Plugins.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;PublishAot;PublishTrimmed;SelfContained" />
    <CompilerVisibleProperty Include="DshPluginHost" />
  </ItemGroup>


  <Import Project="$(MSBuildThisFileDirectory)..\..\native\plugin_guard\PluginGuard.props" />

</Project>
