<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Notification model and persistent history shared by the GUI, CLI and WebUI clients.
    Shared capability library without a plugin entry: events from every machine and session are appended to one JSONL file per client.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
