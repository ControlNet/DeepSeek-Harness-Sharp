<Project>
  <PropertyGroup>
    <_IrohRoot>$(MSBuildThisFileDirectory)..\..\</_IrohRoot>
    <_IrohRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_IrohRid>
    <_IrohRid Condition="'$(_IrohRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_IrohRid>
    <_IrohFile>iroh-ssh</_IrohFile>
    <_IrohFile Condition="'$(_IrohRid)' == 'win-x64' or '$(_IrohRid)' == 'win-arm64'">iroh-ssh.exe</_IrohFile>
    <_IrohDirectory>$(_IrohRoot)artifacts\iroh-ssh\$(_IrohRid)\</_IrohDirectory>
  </PropertyGroup>

  <!-- These private items never enter project-reference content propagation. -->
  <ItemGroup>
    <_IrohComponent Include="$(_IrohDirectory)$(_IrohFile)" RelativePath="tools/$(_IrohFile)" />
    <_IrohComponent Include="$(_IrohDirectory)LICENSE.txt" RelativePath="tools/iroh-ssh.LICENSE.txt" />
    <_IrohComponent Include="$(_IrohDirectory)THIRD-PARTY-LICENSES.txt" RelativePath="tools/iroh-ssh.THIRD-PARTY-LICENSES.txt" />
    <_IrohComponent Include="$(MSBuildThisFileDirectory)iroh-ssh.NOTICE.txt" RelativePath="tools/iroh-ssh.NOTICE.txt" />
  </ItemGroup>

  <Target Name="AcquireIrohSshComponent" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_IrohRid)' != 'linux-x64' and '$(_IrohRid)' != 'linux-arm64' and '$(_IrohRid)' != 'osx-x64' and '$(_IrohRid)' != 'osx-arm64' and '$(_IrohRid)' != 'win-x64' and '$(_IrohRid)' != 'win-arm64'" Text="Bundled iroh-ssh does not support executable RID '$(_IrohRid)'." />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_IrohRoot)scripts\fetch-iroh-ssh.ps1&quot; -Rid &quot;$(_IrohRid)&quot;" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="bash &quot;$(_IrohRoot)scripts/fetch-iroh-ssh.sh&quot; &quot;$(_IrohRid)&quot;" />
  </Target>

  <Target Name="CopyIrohSshComponentToExecutable" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="AcquireIrohSshComponent" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(_IrohComponent)" DestinationFiles="@(_IrohComponent->'$(OutDir)%(RelativePath)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_IrohComponent->'$(OutDir)%(RelativePath)')" />
    </ItemGroup>
  </Target>

  <Target Name="PublishIrohSshComponentForExecutable" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="AcquireIrohSshComponent" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_IrohComponent)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
