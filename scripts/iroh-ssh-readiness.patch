+    /// Wait for either a current direct discovery record or acknowledged relay publication.
+    /// Identity creation and bind() alone do not acknowledge any discovery publisher.
+    pub async fn write_ready_file(&self, path: &Path) -> anyhow::Result<()> {
+        use iroh::address_lookup::{
+            AddressLookup, AddressLookupBuilder, EndpointInfo, PkarrRelayClient,
+            DEFAULT_PKARR_TTL, N0_DNS_PKARR_RELAY_PROD,
+        };
+        use tokio_stream::StreamExt;
+
+        let endpoint = &self.inner.as_ref().expect("inner not set").endpoint;
+        #[cfg(target_os = "macos")]
+        eprintln!("discovery diagnostics: initial {:?}", endpoint.addr());
+        let direct = async {
+            let options = iroh_mdns_peer_lookup::Options::new().announce(false).build();
+            let observer = iroh_mdns_peer_lookup::lookup(options).await?
+                .into_address_lookup(endpoint)?;
+            let results = observer.resolve(endpoint.id())
+                .ok_or_else(|| anyhow::anyhow!("mDNS lookup is unavailable"))?;
+            tokio::pin!(results);
+            while let Some(result) = results.next().await {
+                #[cfg(target_os = "macos")]
+                eprintln!("discovery diagnostics: item {result:?}; current {:?}", endpoint.addr());
+                if let Ok(item) = result {
+                    let current = endpoint.addr();
+                    if item.ip_addrs().any(|addr| current.ip_addrs().any(|ours| ours == addr)) {
+                        return Ok::<(), anyhow::Error>(());
+                    }
+                }
+            }
+            #[cfg(target_os = "macos")]
+            eprintln!("discovery diagnostics: mDNS exhausted; current {:?}", endpoint.addr());
+            bail!("No current direct address was discovered for the receiver")
+        };
+        let relay = async {
+            endpoint.online().await;
+            let mut info = EndpointInfo::from(endpoint.addr());
+            // Match N0's relay-only privacy policy.
+            info.data.clear_ip_addrs();
+            let packet = info.to_pkarr_signed_packet(endpoint.secret_key(), DEFAULT_PKARR_TTL)?;
+            let publisher = PkarrRelayClient::new(
+                N0_DNS_PKARR_RELAY_PROD.parse()?,
+                endpoint.tls_config().clone(),
+                endpoint.dns_resolver()?.clone(),
+            );
+            publisher.publish(&packet).await?;
+            Ok::<(), anyhow::Error>(())
+        };
+        tokio::pin!(direct, relay);
+        // Either branch acknowledges the receiver's existing address lookup paths.
+        tokio::select! {
+            result = &mut direct => if let Err(direct_error) = result {
+                relay.await.map_err(|relay_error| anyhow::anyhow!(
+                    "Receiver discovery failed: {direct_error:#}; {relay_error:#}"
+                ))?;
+            },
+            result = &mut relay => if let Err(relay_error) = result {
+                direct.await.map_err(|direct_error| anyhow::anyhow!(
+                    "Receiver discovery failed: {direct_error:#}; {relay_error:#}"
+                ))?;
+            },
+        }
+
+        let temporary = path.with_extension("tmp");
+        tokio::fs::write(&temporary, format!("{}\n{}\n", endpoint.id(), std::process::id())).await?;
+        tokio::fs::rename(temporary, path).await?;
+        Ok(())
+    }
